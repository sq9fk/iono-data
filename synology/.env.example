# Copy to .env (never commit .env).
# Fine-grained token for iono-trigger: GitHub → Settings → Developer settings → Fine-grained tokens,
# Repository access: only sq9fk/iono-data, Repository permissions: Actions – Read and write.
# Without a token the trigger only waits; the antenna pages are served anyway.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
# only when the page repositories are private: fine-grained token, Contents – Read-only on sq9fk/anteny-sq9um,
# sq9fk/anteny-sq9fk and sq9fk/anteny-sp9pdf (it can be the same token as above, with those repositories added;
# adding a repository to the token keeps its value, .env stays as it is)
SYNC_TOKEN=
# port of the antenna pages on the NAS: http://<NAS>:8090/
WEB_PORT=8090
# address of the pages through Traefik (external network TRAEFIK_NETWORK, certresolver cloudflare)
ANTENY_HOST=anteny.terapiagaska.pl
TRAEFIK_NETWORK=frontend
# optional
# INTERVAL=900          relay trigger, seconds (at least 300)
# SYNC_INTERVAL=60      page copies: check for a new commit every … seconds (at least 30)
# REPOS=sq9fk/anteny-sq9um sq9fk/anteny-sq9fk
