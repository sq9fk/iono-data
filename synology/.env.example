# Copy to .env (never commit .env).
# Fine-grained token for iono-trigger: GitHub → Settings → Developer settings → Fine-grained tokens,
# Repository access: only sq9fk/iono-data, Repository permissions: Actions – Read and write.
# Without a token the trigger only waits; the antenna pages are served anyway.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
# port of the antenna pages on the NAS: http://<NAS>:8090/
WEB_PORT=8090
# optional
# INTERVAL=900          relay trigger, seconds (at least 300)
# SYNC_INTERVAL=900     page copies refresh, seconds
# REPOS=sq9fk/anteny-sq9um sq9fk/anteny-sq9fk
